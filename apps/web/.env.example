# Supabase（未設定なら認証オフ。V0.1 はローカル data/store.json だけで動く）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google ログインを許可するメール（カンマ区切り / 空なら認証済みなら誰でも通る）
LUMINA_ALLOWED_EMAILS=

# Service role keys must never be committed or stored in DB.
# Google の Client ID / Secret も Supabase Dashboard 側に置く。ここには書かない。
